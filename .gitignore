# Credentials & secrets — never commit
.envrc
.env
.env.*
.token-cache
*.jwk
*.pem
*.key
*.har

# Rust build output
/target/
**/*.rs.bk
Cargo.lock.bak

# Script-sync workspace (created at runtime; per-tenant/realm trees + snapshots)
/workspace/
/local-config/

# Tool venvs / caches
/.venv-tools/
/.direnv/
/tmp/
__pycache__/

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (per-developer allowlists, etc.)
.claude/settings.local.json

# Runtime project-local state (created by pingone-aic-manager at runtime)
.aic/
# Legacy runtime dir (pre-rename); keep ignored so old workspaces never get committed
.aic-edit/

# Managed-object backups (raw schema dumps for experimentation safety)
/.managed-backup/

# Machine-local AI agent notes (sandbox tenant, sibling-checkout paths).
# .ai/core.md and .ai/local.md.example ARE committed; local.md is not.
/.ai/local.md

# Personal todos
TODO.md

# Inbound defect reports from other agents — scratch, not project history
/ISSUES.md

# Optional literal denylist for scripts/check-sensitive-metadata.sh.
# Never committed: a list of client names IS the client names.
/.ai/denylist.txt

# Local Rhino mock-surface generator (scripts/rhino-local/ts)
scripts/rhino-local/ts/node_modules/

# Friction found while using `aic` on real tickets. `gaps/` is the raw inbox,
# GAPS.md the ranked queue over it. Both are working notes with a finite life:
# they shrink as the items land and go away entirely when the last one does.
/GAPS.md
/gaps/

# AM Rhino jars extracted from the local docker image by
# scripts/rhino-local/fetch-jars.sh. Never commit a jar.
/.rhino-local/
/.ai/agent/
