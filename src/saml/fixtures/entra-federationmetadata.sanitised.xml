<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored from the SAML 2.0 metadata and WS-Federation schemas to match
  the SHAPE of an Entra ID `federationmetadata.xml`. No byte of it came from a
  tenant: the GUID is the all-zeros placeholder and the certificate is a
  throwaway self-signed key generated for this file.

  Endpoint attributes sit one per line so no line pairs an element name with a
  host; `scripts/check-sensitive-metadata.sh` reads lines, not elements, and a
  reflow would hand it a false positive to argue with.
-->
<EntityDescriptor xmlns="urn:oasis:names:tc:SAML:2.0:metadata"
                  xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
                  ID="_00000000-0000-0000-0000-000000000000"
                  entityID="https://sts.windows.net/00000000-0000-0000-0000-000000000000/">
  <IDPSSODescriptor protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
    <KeyDescriptor use="signing">
      <ds:KeyInfo>
        <ds:X509Data>
          <ds:X509Certificate></ds:X509Certificate>
        </ds:X509Data>
      </ds:KeyInfo>
    </KeyDescriptor>
    <SingleLogoutService
        Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
        Location="https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/saml2" />
    <SingleSignOnService
        Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
        Location="https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/saml2" />
    <SingleSignOnService
        Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
        Location="https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/saml2" />
  </IDPSSODescriptor>
</EntityDescriptor>
