{
  "compilerOptions": {
    "lib": [
      "ES5",
      "ES2015.Core",
      "ES2015.Collection",
      "ES2015.Iterable",
      "ES2015.Symbol",
      "ES2015.Symbol.WellKnown",
      "ES2015.Promise",
      "ES2016.Array.Include"
    ],
    "module": "commonjs",
    "target": "ES6",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": [],
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true
  },
  "//": "Settings-only base. The per-folder leaf tsconfigs (endpoint/, schedule/, managed/<object>/) extend this and set their own `include`. Type-check via `npm run type-check` (tools/check-types.mjs).",
  "files": [],
  "exclude": ["node_modules", "dist"]
}
