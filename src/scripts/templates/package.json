{
  "name": "p1-aic-scripts",
  "version": "1.0.0",
  "description": "PingOne Advanced Identity Cloud scripts",
  "type": "module",
  "scripts": {
    "lint": "(cd am && eslint .) && (cd idm && eslint .)",
    "lint:fix": "(cd am && eslint . --fix) && (cd idm && eslint . --fix)",
    "format": "prettier --write am/**/*.{js,cjs,ts} idm/**/*.{js,cjs,ts}",
    "format:check": "prettier --check am/**/*.{js,cjs,ts} idm/**/*.{js,cjs,ts}",
    "test": "jest",
    "type-check": "node tools/check-types.mjs",
    "build": "node tools/check-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/lodash": "3.10.1",
    "@types/node": "^20.0.0",
    "@types/validator": "13.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "handlebars": "4.7.9",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}