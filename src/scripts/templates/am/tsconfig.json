{
  "compilerOptions": {
    "lib": ["ES2015", "ES2016.Array.Include"],
    "module": "commonjs",
    "target": "ES6",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": [],
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true
  },
  "//": "Settings-only base. The per-folder leaf tsconfigs extend this and set their own `include`; this base intentionally includes no files because the types/ overlays redeclare globals and cannot share one program. Type-check via `npm run type-check` (tools/check-types.mjs runs each leaf).",
  "files": [],
  "exclude": ["node_modules", "dist"]
}