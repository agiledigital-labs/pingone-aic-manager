{
  "name": "rhino-local-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Rhino harness: mock-surface generator and typed client for the long-lived JVM runner.",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/harness/index.d.ts",
      "default": "./dist/src/harness/index.js"
    },
    "./case": {
      "types": "./dist/src/case/index.d.ts",
      "default": "./dist/src/case/index.js"
    },
    "./aic": {
      "types": "./dist/src/aic/index.d.ts",
      "default": "./dist/src/aic/index.js"
    },
    "./bindings": {
      "types": "./dist/src/bindings/index.d.ts",
      "default": "./dist/src/bindings/index.js"
    },
    "./runner": {
      "types": "./dist/src/runner.d.ts",
      "default": "./dist/src/runner.js"
    },
    "./profile": {
      "types": "./dist/src/profile/index.d.ts",
      "default": "./dist/src/profile/index.js"
    },
    "./diagnostics": {
      "types": "./dist/src/diagnostics.d.ts",
      "default": "./dist/src/diagnostics.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rhino-local-show-log": "dist/bin/show-log.js",
    "rhino-local-pull-profile": "dist/bin/pull-profile.js",
    "rhino-local-fetch-jar": "dist/bin/fetch-jar.js"
  },
  "files": [
    "dist/",
    "generated/",
    "java/*.java",
    "src/bindings/rhino/runtime.cjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node src/generate.ts",
    "measure": "node src/measure.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:am": "eslint --config eslint.am.config.js generated src/bindings cases --max-warnings 0",
    "pull-profile": "node bin/pull-profile.ts",
    "show-log": "node bin/show-log.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node src/build-classes.ts",
    "fetch-jar": "node bin/fetch-jar.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.4",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7",
    "zod": "^4.6.4"
  },
  "peerDependencies": {
    "vitest": "^3.2.7",
    "zod": "^4.6.4"
  }
}
